# Web credentials, account passwords, and the persisted token state belong only in /root/projects/lottery-bot (chmod 600).
LOTTERY_BASE_URL=https://www.0809.one
STATE_PATH=/root/projects/lottery-bot/data/state.json
USER_AGENT=SkyeLotteryBot/1.0

# Web workbench. Keep the listener on loopback and put it behind HTTPS nginx.
WEB_ADDR=127.0.0.1:18090
WEB_USERNAME=change-this-admin
WEB_PASSWORD=change-this-password

# Usernames and passwords remain server-only. They allow the workbench to renew
# a saved token after expiry; neither is returned to the browser.
ACCOUNT_A_USERNAME=replace-with-account-a-username
ACCOUNT_A_PASSWORD=replace-with-account-a-password
ACCOUNT_B_USERNAME=replace-with-account-b-username
ACCOUNT_B_PASSWORD=replace-with-account-b-password
ACCOUNT_C_USERNAME=replace-with-account-c-username
ACCOUNT_C_PASSWORD=replace-with-account-c-password
ACCOUNT_D_USERNAME=replace-with-account-d-username
ACCOUNT_D_PASSWORD=replace-with-account-d-password
ACCOUNT_E_USERNAME=replace-with-account-e-username
ACCOUNT_E_PASSWORD=replace-with-account-e-password
